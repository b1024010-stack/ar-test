        def Material "M0"
        {
            token outputs:surface.connect = </Root/Materials/M0/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Root/Materials/M0/Tex.outputs:rgb>
                float inputs:roughness = 0.4
                float inputs:metallic = 0
                token outputs:surface
            }
            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Tex"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/wrap.jpg@
                float2 inputs:st.connect = </Root/Materials/M0/StReader.outputs:result>
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
